# Copy to .env and fill in from Supabase → Project Settings → API Keys.
# Leave both blank to run Dogdex in local-only mode (no sign-in, no sync).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=


# Public address of the deployed site, no trailing slash (e.g. https://dogdex.example.com).
# Used for the link-preview image (og-image) and canonical URL; previews on Slack, iMessage, X and
# Facebook need an absolute address. Leave blank for local development.
VITE_SITE_URL=
